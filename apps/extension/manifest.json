{
  "manifest_version": 3,
  "name": "Cermin Feed Capture",
  "version": "0.1.0",
  "description": "Capture a user-initiated snapshot of visible feed items for local Cermin analysis.",
  "permissions": ["activeTab", "scripting", "storage", "downloads"],
  "action": {
    "default_title": "Cermin",
    "default_popup": "src/popup.html"
  },
  "background": {
    "service_worker": "src/service-worker.js"
  }
}
